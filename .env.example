# ──────────────────────────────────────────────
# Copy this file to `.env.local` (development) or set these in your
# Hostinger hPanel → Node.js app → Environment variables (production),
# then fill in real values. Do NOT commit the filled-in file.
# ──────────────────────────────────────────────

# MySQL connection (create the database + user in hPanel → Databases → MySQL).
# On Hostinger shared hosting the DB runs on the same host as the app, so the
# host is usually "localhost". The username/database are prefixed (e.g. u123456_qr).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name
# Keep this low — shared hosting limits concurrent connections.
MYSQL_CONNECTION_LIMIT=5

# Secret used to sign auth JWTs. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-secret

# Registration is invite-only: only people who enter this exact code on the
# /register page can create an account. Share it only with your team. Leave it
# UNSET to disable new sign-ups entirely (existing users can still log in).
# Use a long random value, e.g. `openssl rand -hex 16`.
SIGNUP_INVITE_CODE=change-me-to-a-shared-invite-code

# Email alerts for invite requests (the website's "Request an invite" form),
# sent through Resend (https://resend.com). Requests are always saved and listed
# at /admin/invites; with an API key set, the team is also emailed about each
# one. Create the key in Resend → API Keys (it only needs "Sending access").
RESEND_API_KEY=re_your_resend_api_key
# Optional sender. Its domain must be verified in Resend → Domains.
# Defaults to "QR Go <mail@qr.openform.co.za>".
# INVITE_ALERT_FROM=QR Go <mail@qr.openform.co.za>
# Optional: who gets the alerts (comma-separated). Defaults to kenton@openform.co.za.
# INVITE_ALERT_EMAILS=kenton@openform.co.za,another@your-company.com

# Who can open the admin dashboard (/admin) to view every account and change
# its package. Comma-separated email addresses of existing accounts
# (case-insensitive). Leave it UNSET and nobody can access the admin dashboard.
ADMIN_EMAILS=you@your-company.com

# Public base URL of the deployed site (used to build QR redirect links).
# No trailing slash. e.g. https://your-domain.com
BASE_URL=http://localhost:3000

# Scan analytics. Secret for the anonymous visitor IDs used to count unique
# scanners (IP addresses are never stored). Falls back to JWT_SECRET if unset.
# Use a long random value, e.g. `openssl rand -hex 32`.
ANALYTICS_SECRET=change-me-to-a-long-random-secret

# How many months of detailed scan records to keep (default 24; 0 = forever).
# Each code's total scan count is always kept.
ANALYTICS_RETENTION_MONTHS=24
